source "https://rubygems.org"

# 참고: 이 블로그는 GitHub Pages "레거시" 빌드(Settings > Pages > Branch)를 사용하므로
# 실제 배포는 GitHub이 자체 pinned `github-pages` 젬 환경으로 서버에서 빌드하며
# 이 Gemfile을 참조하지 않는다. 이 Gemfile은 로컬 미리보기(jekyll serve)용이다.
gem "jekyll", "~> 4.3"
gem "webrick"

gem "jekyll-remote-theme"
gem "jekyll-paginate"
gem "jekyll-sitemap"
gem "jekyll-seo-tag"
